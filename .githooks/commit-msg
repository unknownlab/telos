#!/bin/sh
# Enforce Conventional Commits 1.0.0 (https://www.conventionalcommits.org/en/v1.0.0/)
# and forbid AI author/co-author attribution.
# Enabled per clone: git config core.hooksPath "$(git rev-parse --show-toplevel)/.githooks"

msg_file="$1"

fail() {
  echo "commit-msg: $1" >&2
  echo "Expected: <type>[optional scope][!]: <description>, then an optional body and footers, each after one blank line." >&2
  echo "See https://www.conventionalcommits.org/en/v1.0.0/" >&2
  exit 1
}

subject=$(grep -v '^#' "$msg_file" | sed -n '1p')

# Messages generated by git itself.
case "$subject" in
  "Merge "* | "Revert \""* | "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
esac

# Spec Kitty 3.2.7 writes these four messages itself and has no setting to change them.
# Rewrite them to the convention instead of breaking the mission workflow.
rewritten=$(printf '%s\n' "$subject" | sed -E \
  -e 's/^Add (.+) for feature ([^ ]+)$/docs(\2): add \1/' \
  -e 's/^Finalize acceptance artifacts for ([^ ]+)$/chore(\1): finalize acceptance artifacts/' \
  -e 's/^Record acceptance commit for ([^ ]+)$/chore(\1): record acceptance commit/' \
  -e 's/^Accept ([^ ]+)$/chore(\1): accept mission/')
if [ "$rewritten" != "$subject" ]; then
  tmp="$msg_file.tmp.$$"
  { printf '%s\n' "$rewritten"; sed '1d' "$msg_file"; } > "$tmp" && mv "$tmp" "$msg_file"
  subject="$rewritten"
fi

printf '%s\n' "$subject" | grep -Eq '^[A-Za-z][A-Za-z-]*(\([^()]+\))?!?: [^ ].*$' \
  || fail "subject does not follow Conventional Commits: \"$subject\""

second=$(grep -v '^#' "$msg_file" | sed -n '2p')
[ -z "$second" ] || fail "the body must start after one blank line"

if grep -v '^#' "$msg_file" | grep -Eiq '^(co-authored-by|author|signed-off-by):.*(claude|anthropic|codex|openai|chatgpt|copilot|noreply@anthropic)'; then
  fail "AI author or co-author lines are not allowed"
fi
if grep -v '^#' "$msg_file" | grep -Eiq 'generated with \[?claude|🤖'; then
  fail "AI attribution text is not allowed"
fi

exit 0

{
  "name": "telos",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.4.4-canary.1"
  },
  "packageManager": "bun@1.4.4-canary.1",
  "scripts": {
    "preinstall": "$npm_execpath scripts/check-bun-version.ts",
    "check:bun": "bun scripts/check-bun-version.ts",
    "typecheck": "bun run check:bun && bun check -b",
    "lint": "bun run check:bun && bun lint --no-script",
    "lint:fix": "bun lint --no-script --fix",
    "format": "bun fmt --no-script",
    "format:check": "bun fmt --no-script --check",
    "test": "bun run check:bun && bun test --pass-with-no-tests",
    "grace:lint": "grace lint --path . --assertions current",
    "docs:build": "bun run --cwd apps/docs build && bun apps/docs/scripts/check-verification.ts",
    "docs:preview": "bun run --cwd apps/docs preview",
    "test:e2e": "bun run --cwd apps/docs test:e2e",
    "calculator": "bun apps/calculator/bin/cli.ts",
    "calculator:mcp": "bun apps/calculator/bin/mcp.ts",
    "calculator:agent-demo": "bun apps/calculator/bin/agent-demo.ts",
    "telos": "bun scripts/telos.ts",
    "telos:check": "bun scripts/telos.ts check",
    "verify": "bun run check:bun && bun run format:check && bun run lint && bun run typecheck && bun run test && bun run docs:build && bun run test:e2e && bun run grace:lint && bun run telos:check"
  },
  "dependencies": {
    "@telos/calculator": "workspace:*",
    "@telos/cli": "workspace:*",
    "@telos/kernel": "workspace:*",
    "effect": "4.0.4"
  },
  "devDependencies": {
    "@types/bun": "1.4.3"
  }
}
